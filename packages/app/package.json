{
  "name": "@docleus/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Frontend host: routing, login, organizations and spaces, settings, UI slots, and loading of plugin editor entries.",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.site.config.ts",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@docleus/sdk": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Docleus/docleus-core.git",
    "directory": "packages/app"
  }
}
